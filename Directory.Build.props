<Project>

  <!--
    全プロジェクト共通の設定。

    TreatWarningsAsErrors を入れているのは、このリポジトリに ESLint / Prettier に相当する
    静的解析を「足さない」と決めているため。コンパイラの警告が唯一の自動検査なので、
    無視できてしまうと存在しないのと同じになる。

    NuGet の監査警告（NU19xx）だけは除外する。新しい脆弱性が公表された日に、
    こちらが何も変えていないのにビルドが落ちる、という壊れ方を避けるため。警告としては出る。
  -->

  <!--
    著作権表示は exe のバージョン情報に焼かれる。**消さないこと。**
    Windows SDK のライセンス条項 §2.a.ii が、同梱した再頒布可能コードを配る条件として
    「自分の著作権表示を出すこと」を要求している（THIRD-PARTY-NOTICES.md を参照）。
  -->
  <PropertyGroup>
    <Product>voxbridge</Product>
    <Copyright>Copyright (c) 2026 koshian</Copyright>
    <Description>OS に最初から入っている音声を OpenAI 互換の HTTP API で喋らせる常駐サーバ</Description>
  </PropertyGroup>

  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <WarningsNotAsErrors>NU1901;NU1902;NU1903;NU1904</WarningsNotAsErrors>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <NeutralLanguage>ja-JP</NeutralLanguage>
  </PropertyGroup>

</Project>
